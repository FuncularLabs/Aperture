<Window x:Class="Aperture.App.OnlineOnlyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online-only files" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F7F8FA" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="Assets/aperture.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1F2430" />
        <SolidColorBrush x:Key="Muted" Color="#8A90A0" />
        <SolidColorBrush x:Key="Accent" Color="#3A72F0" />
        <SolidColorBrush x:Key="Line" Color="#E2E5EA" />
    </Window.Resources>

    <!-- 0.9.2 C1: what to do with the online-only files an index would download. No button is Cancel: Esc and the
         close box leave the answer empty, which the window takes as Skip, for now only (C5). -->
    <StackPanel Margin="20">
        <TextBlock x:Name="HeadlineText" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="15"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap"
                   Text="They're stored in the cloud, not on this PC: indexing them downloads each one. In the background, your other files are indexed first, then these, one at a time." />

        <CheckBox x:Name="RememberCheck" IsChecked="False" Foreground="{StaticResource Ink}" FontSize="13">
            <TextBlock Text="Remember for this folder" />
        </CheckBox>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="22,2,0,0" TextWrapping="Wrap"
                   Text="You can change it later from the folder's right-click menu (Online-only files)." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="Skip them" IsDefault="True" Padding="14,6" Margin="0,0,8,0" Click="OnSkip"
                    Background="#E6EEFF" BorderBrush="{StaticResource Accent}" />
            <Button x:Name="BackgroundButton" Content="Index in the background" Padding="14,6" Margin="0,0,8,0"
                    Click="OnBackground" />
            <Button x:Name="NowButton" Content="Index now" Padding="14,6" Click="OnNow" />
        </StackPanel>
    </StackPanel>
</Window>
