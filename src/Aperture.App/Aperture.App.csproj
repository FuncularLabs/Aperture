<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aperture.Core\Aperture.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\aperture.ico</ApplicationIcon>
    <AssemblyName>Aperture</AssemblyName>
    <Version>0.8.8</Version>
    <AssemblyTitle>Aperture Image Browser</AssemblyTitle>
    <Product>Aperture Image Browser</Product>
    <Description>A fast, local image &amp; video browser and organizer for Windows.</Description>
    <Company>Funcular Labs</Company>
    <Authors>Funcular Labs</Authors>
    <Copyright>© 2026 Funcular Labs</Copyright>
    <!-- Don't append the +git-sha suffix to InformationalVersion — it clutters
         the About line and the update check parses it as the running version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- A single-file publish carries its native DLLs (e_sqlite3, libSkiaSharp,
         Microsoft.Data.SqlClient.SNI) inside the exe. Without this they are loose files
         beside it, and an exe copied anywhere on its own dies at startup with
         DllNotFoundException. The release workflow passed this on the command line;
         a local publish.ps1 did not, which is how 0.8.6-beta1 shipped a bare exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aperture.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\aperture.ico" />
    <Resource Include="Assets\mascot.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the README next to the exe, with its images under docs/ so the relative
         paths resolve when the README is viewed from the distributed app folder.
         (Relative paths — not base64 — because GitHub sanitizes/rejects data: URIs.) -->
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\logo.png" Link="docs\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\screenshot.png" Link="docs\screenshot.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
