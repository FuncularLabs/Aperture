<Project>

  <!--
    Override the transitive SQLitePCLRaw native bundle. Microsoft.Data.Sqlite 10.0.9
    pulls in bundle_e_sqlite3 2.1.11, which carries GHSA-2m69-gcr7-jv3q (high). The fix
    ships in the 3.0.x line. This pin is verified against the Aperture.Core test suite
    (real SQLite read/write/BLOB round-trips) — revisit when Microsoft.Data.Sqlite
    references a patched bundle itself.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <!--
    Override the transitive System.Security.Cryptography.Pkcs. Funcular.Data.Orm 3.10.1 ->
    Microsoft.Data.SqlClient 6.0.0 pulls in Pkcs 9.0.0, which carries GHSA-846f-f764-76mx
    (high) and GHSA-2fmv-rv2c-59x7 (moderate); 9.0.21 is the first 9.x outside both ranges.
    Only Aperture.Core and the test project restore the package: the WPF app gets Pkcs
    from the Microsoft.WindowsDesktop.App shared framework and prunes the package, so the
    running app's copy comes from the installed .NET Desktop Runtime (patched in 10.0.13).
    The pin is skipped for WPF projects because a direct reference to a framework-provided
    package is not pruned and draws NU1510 instead. (Item conditions see the project's
    final property values, so UseWPF set in the csproj is visible here.)
    Aperture never opens a SQL Server connection, so SqlClient and Pkcs are never reached.
    Guarded by DependencyAdvisoryTests — revisit when SqlClient references a patched Pkcs.
  -->
  <ItemGroup Condition="'$(UseWPF)' != 'true'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

</Project>
