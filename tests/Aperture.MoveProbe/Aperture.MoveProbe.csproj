<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A process that isn't long-path aware, as Aperture.exe isn't: FileMovesTests runs a move in it, since the test host
    is long-path aware and so hides what a path past 260 characters does to Windows' own calls (0.9.2 review round 15,
    R F-1). Built by the test project's reference to it; never packed or shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aperture.Core\Aperture.Core.csproj" />
  </ItemGroup>

</Project>
