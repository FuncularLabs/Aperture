<?xml version="1.0" encoding="utf-8"?>
<!--
  As Aperture.exe's (the SDK's default): asInvoker, and no longPathAware, so this process takes long paths only in their
  \\?\ form, whatever the PC's LongPathsEnabled says. Don't add longPathAware: the probe would prove nothing.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Aperture.MoveProbe.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
